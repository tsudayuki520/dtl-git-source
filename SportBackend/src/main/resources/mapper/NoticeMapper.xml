<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dlust.sportbackend.Mapper.NoticeMapper">

    <select id="selectAll" resultType="com.dlust.sportbackend.entity.Notice">
        SELECT id, title, content, create_time, update_time
        FROM notice
        ORDER BY create_time DESC
    </select>

    <select id="selectById" resultType="com.dlust.sportbackend.entity.Notice">
        SELECT id, title, content, create_time, update_time
        FROM notice
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.dlust.sportbackend.entity.Notice" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO notice (title, content)
        VALUES (#{title}, #{content})
    </insert>

    <update id="updateById" parameterType="com.dlust.sportbackend.entity.Notice">
        UPDATE notice
        SET title = #{title},
            content = #{content}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM notice WHERE id = #{id}
    </delete>

</mapper>
