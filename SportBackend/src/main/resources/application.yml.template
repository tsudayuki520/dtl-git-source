server:
  port: 8080

spring:
  data:
    redis:
      host: ${REDIS_HOST:127.0.0.1}
      port: ${REDIS_PORT:6379}
      password: ${REDIS_PASSWORD:}
      database: 0
      connect-timeout: 2s
      timeout: 2s
  datasource:
    url: jdbc:mysql://localhost:3306/sport_db?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
    username: root
    password: 你的数据库密码
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      pool-name: SportHikariPool
      maximum-pool-size: 20
      minimum-idle: 5
      connection-timeout: 30000
      idle-timeout: 600000
      max-lifetime: 1800000

mybatis:
  mapper-locations: classpath:mapper/*.xml
  type-aliases-package: com.dlust.sportbackend.entity
  configuration:
    map-underscore-to-camel-case: true

# 微信小程序配置（替换为你自己的 AppID 和 AppSecret）
wechat:
  appid: 你的小程序AppID
  secret: 你的小程序AppSecret

# Redis 仅做报名写入准入互斥；最终限报判断在 MySQL 悲观锁事务内进行。
sport:
  registration:
    redis-key-prefix: 'sport:registration:'
    lease-millis: 30000
    wait-millis: 2000
