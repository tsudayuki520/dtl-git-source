server:
  port: 8080

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/sport_db?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
    username: root
    password: 你的数据库密码
    driver-class-name: com.mysql.cj.jdbc.Driver

mybatis:
  mapper-locations: classpath:mapper/*.xml
  type-aliases-package: com.dlust.sportbackend.entity
  configuration:
    map-underscore-to-camel-case: true

# 微信小程序配置（替换为你自己的 AppID 和 AppSecret）
wechat:
  appid: 你的小程序AppID
  secret: 你的小程序AppSecret
