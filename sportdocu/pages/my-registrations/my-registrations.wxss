@import "../../styles/lists.wxss";
.meeting-name { padding-bottom: 24rpx; border-bottom: 1rpx solid var(--sport-border); }
.item-card { padding: 26rpx 0; border-bottom: 1rpx solid var(--sport-border); }
.item-card:last-child { padding-bottom: 0; border-bottom: 0; }
.item-name { flex: 1; min-width: 0; font-size: 30rpx; font-weight: 600; word-break: break-all; }
.item-schedule { margin-top: 12rpx; }
