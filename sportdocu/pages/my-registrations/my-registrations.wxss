/**my-registrations.wxss**/
page { background-color: #f5f5f5; }
.mr-page { height: 100vh; padding: 24rpx; box-sizing: border-box; }
.empty { text-align: center; padding: 80rpx 0; color: #909399; font-size: 28rpx; }
.summary {
  font-size: 26rpx; color: #2196F3; padding: 16rpx 8rpx;
}
.meeting-group {
  background: #fff; border-radius: 16rpx; padding: 24rpx 28rpx;
  margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.meeting-name {
  font-size: 32rpx; font-weight: bold; color: #303133;
  padding-bottom: 16rpx; margin-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.item-card { padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.item-card:last-child { border-bottom: none; }
.item-header { display: flex; justify-content: space-between; align-items: center; }
.item-name { font-size: 28rpx; color: #303133; font-weight: 500; }
.item-category {
  font-size: 22rpx; color: #2196F3;
  background: #e3f2fd; padding: 4rpx 16rpx; border-radius: 8rpx;
}
.item-schedule { display: block; font-size: 24rpx; color: #909399; margin-top: 8rpx; }
