@import "../../styles/lists.wxss";
.group-tabs { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 28rpx; }
.group-tab { display: flex; align-items: center; justify-content: center; min-height: max(88rpx,44px); padding: 0 26rpx; border-radius: 18rpx; background: #fff; border: 1rpx solid var(--sport-border); color: var(--sport-muted); font-size: 26rpx; box-sizing: border-box; }
.group-tab.active { color: #fff; background: var(--sport-primary); border-color: var(--sport-primary); font-weight: 600; }
.event-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16rpx; padding-top: 24rpx; margin-top: 24rpx; border-top: 1rpx solid var(--sport-border); }
.event-reg-count { color: var(--sport-muted); font-size: 24rpx; }
.event-card:active { background: #f8faff; }
