/**event.wxss - 比赛项目列表**/
page {
  background-color: #f5f5f5;
}
.event-page {
  height: 100vh;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

/* 组别筛选 Tab */
.group-tabs {
  display: flex;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.group-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.group-tab.active {
  background-color: #2196F3;
  color: #ffffff;
  font-weight: bold;
}

/* 项目卡片 */
.event-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.event-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.event-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
}

.event-status {
  font-size: 22rpx;
  color: #ffffff;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.event-footer {
  display: flex;
  align-items: center;
}

.event-group {
  font-size: 24rpx;
  color: #2196F3;
  background-color: #e3f2fd;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}
