<!--event.wxml - 比赛项目列表-->
<scroll-view class="event-page" scroll-y>
  <!-- 组别筛选 Tab -->
  <view class="group-tabs">
    <view
      wx:for="{{groupTypes}}"
      wx:key="id"
      class="group-tab {{currentGroup === item.id ? 'active' : ''}}"
      data-group-type-id="{{item.id}}"
      bindtap="switchGroup"
    >
      {{item.name}}
    </view>
  </view>

  <!-- 项目列表 -->
  <view class="event-card" wx:for="{{events}}" wx:key="id" bindtap="goToEventRegistrations" data-id="{{item.id}}" data-name="{{item.name}}">
    <view class="event-header">
      <text class="event-name">{{item.name}}</text>
      <text class="event-status" style="background-color: {{statusColor[item.status]}}">{{statusMap[item.status]}}</text>
    </view>
    <view class="event-footer">
      <text class="event-group">{{item.groupTypeName}}</text>
      <text class="event-reg-count">已报名 {{item.registeredCount || 0}}<text wx:if="{{item.registerLimit > 0}}"> / {{item.registerLimit}}</text><text wx:else> · 不限</text></text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-tip" wx:if="{{events.length === 0}}">
    <text>暂无项目信息</text>
  </view>
</scroll-view>
