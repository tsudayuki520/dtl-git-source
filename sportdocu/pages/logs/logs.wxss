page { height: 100vh; display: flex; flex-direction: column; }
.scrollarea { flex: 1; overflow-y: hidden; }
.log-item { margin: 20rpx 28rpx; padding: 26rpx; background: #fff; border: 1rpx solid var(--sport-border); border-radius: 22rpx; color: var(--sport-muted); font-size: 26rpx; }
.log-item:last-child { margin-bottom: calc(28rpx + env(safe-area-inset-bottom)); }
