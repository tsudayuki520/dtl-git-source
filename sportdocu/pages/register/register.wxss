/* register.wxss */
page {
  background-color: #f5f5f5;
}

.register-page {
  padding: 20rpx 24rpx;
}

.register-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

/* 分类标签 */
.category-label {
  font-size: 26rpx;
  color: #2196F3;
  font-weight: bold;
  margin: 16rpx 0 12rpx 8rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #2196F3;
}

/* 项目列表 */
.event-list {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.event-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.event-item:last-child {
  border-bottom: none;
}

/* 项目详情 */
.event-detail {
  display: flex;
  flex-direction: column;
  flex: 1;
  margin-right: 16rpx;
}

.event-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.event-meta {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.event-count {
  font-size: 20rpx;
  color: #FF9800;
  margin-top: 6rpx;
}

/* 每行报名按钮 */
.register-btn {
  background-color: #4CAF50;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.register-btn:active {
  opacity: 0.8;
}

.register-btn.registered {
  background-color: #cccccc;
}

.register-btn.full {
  background-color: #ff5722;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}
