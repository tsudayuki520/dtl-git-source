@import "../../styles/lists.wxss";
.register-page { padding: 32rpx 28rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.register-title { font-size: 40rpx; font-weight: 700; margin-bottom: 12rpx; }
.category-label { font-size: 28rpx; font-weight: 600; color: var(--sport-primary); border-left: 6rpx solid var(--sport-primary); padding-left: 16rpx; margin: 32rpx 0 20rpx; }
.event-list { border: 1rpx solid var(--sport-border); background: #fff; border-radius: 28rpx; overflow: hidden; box-shadow: var(--sport-shadow); }
.event-item { display: flex; align-items: center; gap: 24rpx; padding: 30rpx; border-bottom: 1rpx solid var(--sport-border); }
.event-item:last-child { border: 0; }
.event-detail { flex: 1; min-width: 0; }
.event-name { font-size: 30rpx; }
.event-meta,.event-count { display: block; color: var(--sport-muted); font-size: 24rpx; margin-top: 10rpx; }
.register-btn { display: flex; align-items: center; justify-content: center; min-height: max(88rpx,44px); padding: 0 28rpx; font-size: 26rpx; font-weight: 600; color: var(--sport-primary); background: var(--sport-primary-soft); border-radius: 18rpx; flex-shrink: 0; }
.register-btn.full,.register-btn.registered { color: #65758c; background: #f0f3f7; }
@media (max-width:350px) { .event-meta,.event-count { font-size: 12px; } }
