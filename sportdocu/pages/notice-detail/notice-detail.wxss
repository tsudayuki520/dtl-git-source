/**notice-detail.wxss**/
page {
  background-color: #f5f5f5;
}
.page {
  height: 100vh;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}
.detail-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}
.detail-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}
.detail-time {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 24rpx;
}
.divider {
  height: 1rpx;
  background-color: #eee;
  margin-bottom: 24rpx;
}
.detail-content {
  font-size: 30rpx;
  color: #444;
  line-height: 1.8;
}
