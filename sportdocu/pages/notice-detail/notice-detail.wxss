@import "../../styles/lists.wxss";
.detail-card { padding: 40rpx 32rpx; }
.detail-title { display: block; font-size: 40rpx; font-weight: 700; line-height: 1.55; word-break: break-all; }
.detail-time { display: block; font-size: 24rpx; color: var(--sport-muted); margin-top: 24rpx; }
.divider { height: 1rpx; background: var(--sport-border); margin: 32rpx 0; }
.detail-content { display: block; font-size: 30rpx; color: #344761; line-height: 1.95; white-space: pre-wrap; word-break: break-all; }
