@import "../../styles/lists.wxss";
.schedule-card { position: relative; overflow: hidden; }
.schedule-card::before { content: ""; position: absolute; left: 0; top: 32rpx; bottom: 32rpx; width: 6rpx; background: #92b3ef; border-radius: 6rpx; }
.schedule-footer { display: flex; justify-content: flex-end; padding-top: 24rpx; margin-top: 24rpx; border-top: 1rpx solid var(--sport-border); }
.schedule-arrow { font-size: 26rpx; color: var(--sport-primary); }
.schedule-card:active { background: #f8faff; }
