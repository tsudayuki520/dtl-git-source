<!--schedule.wxml - 赛程轮次列表-->
<scroll-view class="schedule-page" scroll-y>
  <!-- 轮次列表 -->
  <view
    class="schedule-card"
    wx:for="{{schedules}}"
    wx:key="id"
    data-id="{{item.id}}"
    data-name="{{item.name}}"
    bindtap="goToEvents"
  >
    <view class="schedule-header">
      <text class="schedule-name">{{item.name}}</text>
      <text class="schedule-status" style="background-color: {{statusColor[item.status]}}">{{statusMap[item.status]}}</text>
    </view>
    <view class="schedule-footer">
      <text class="schedule-arrow">查看项目 ></text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-tip" wx:if="{{schedules.length === 0}}">
    <text>暂无赛程信息</text>
  </view>
</scroll-view>
