<!--schedule.wxml - 赛程轮次列表-->
<scroll-view class="schedule-page" scroll-y>
  <view class="ui-intro"><text class="ui-eyebrow">赛事日程</text><text class="ui-page-title">每一轮，都全力以赴</text><text class="ui-description">选择比赛轮次，查看项目与参赛信息。</text></view>
  <!-- 轮次列表 -->
  <view
    class="schedule-card"
    wx:for="{{schedules}}"
    wx:key="id"
    data-id="{{item.id}}"
    data-name="{{item.name}}"
    bindtap="goToEvents"
  >
    <view class="schedule-header">
      <text class="schedule-name">{{item.name}}</text>
      <text class="ui-status {{item.status === 0 ? 'ui-status-2' : 'ui-status-3'}}">{{statusMap[item.status]}}</text>
    </view>
    <view class="schedule-footer">
      <text class="schedule-arrow">查看比赛项目 →</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-tip" wx:if="{{schedules.length === 0}}">
    <text>暂无赛程信息</text>
  </view>
</scroll-view>
