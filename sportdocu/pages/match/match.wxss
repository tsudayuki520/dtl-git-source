/* match.wxss */
page {
  background-color: #f5f6fa;
}

.match-page {
  padding-bottom: 40rpx;
}

/* ============ 顶部运动会切换 tab ============ */
.meeting-tab-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.meeting-tab-scroll {
  white-space: nowrap;
}

.meeting-tab {
  display: inline-flex;
  align-items: center;
  height: 88rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.meeting-tab.active {
  color: #2196F3;
  font-weight: bold;
}

.meeting-tab.active::after {
  content: '';
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  height: 6rpx;
  border-radius: 6rpx 6rpx 0 0;
  background: linear-gradient(90deg, #2196F3, #00BCD4);
}

/* ============ 项目区域 ============ */
.event-section {
  padding: 24rpx;
}

.section-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.event-card {
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.event-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 28rpx;
}

.event-header:active {
  background-color: #f9f9f9;
}

.event-info {
  flex: 1;
  margin-right: 12rpx;
}

.event-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.event-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.event-meta-item {
  font-size: 22rpx;
  color: #888;
}

.event-cat {
  font-size: 18rpx;
  color: #ffffff;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
}

.event-cat.track {
  background: #2196F3;
}

.event-cat.field {
  background: #4CAF50;
}

.event-cat.team {
  background: #FF9800;
}

.event-arrow {
  font-size: 22rpx;
  color: #999;
  transition: transform 0.2s;
  flex-shrink: 0;
}

.event-arrow.expanded {
  transform: rotate(180deg);
}

/* ============ 名次成绩积分表 ============ */
.event-results {
  border-top: 1rpx solid #f0f0f0;
}

/* 轮次分组（预/复/决） */
.round-block {
  border-top: 1rpx solid #f5f5f5;
}

.round-block:first-child {
  border-top: none;
}

.round-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 28rpx 6rpx;
}

.round-tag {
  font-size: 22rpx;
  color: #ffffff;
  padding: 4rpx 18rpx;
  border-radius: 24rpx;
  font-weight: 600;
}

.round-tag.pre {
  background: #2196F3;
}

.round-tag.semi {
  background: #FF9800;
}

.round-tag.final {
  background: #F44336;
}

.round-tag.other {
  background: #9E9E9E;
}

.round-count {
  font-size: 20rpx;
  color: #bbb;
}

.result-row {
  display: flex;
  align-items: center;
  padding: 18rpx 28rpx;
}

.result-row + .result-row {
  border-top: 1rpx solid #f7f7f7;
}

.result-head {
  background: #f8f9fb;
  font-size: 22rpx;
  color: #999;
  font-weight: 600;
}

.col-rank {
  width: 88rpx;
  text-align: center;
  flex-shrink: 0;
}

.col-name {
  flex: 1;
  padding: 0 12rpx;
  min-width: 0;
}

.col-score {
  width: 180rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  flex-shrink: 0;
}

.col-score.no-score {
  color: #bbb;
  font-weight: normal;
}

.col-points {
  width: 90rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: bold;
  color: #FF9800;
  flex-shrink: 0;
}

.result-name {
  display: block;
  font-size: 26rpx;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.result-unit {
  display: block;
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 名次徽章：前三名金银铜 */
.rank-badge {
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

.rank-badge.rank-0 {
  background: linear-gradient(135deg, #FFD700, #F5A623);
  color: #ffffff;
  font-weight: bold;
  border-radius: 50%;
}

.rank-badge.rank-1 {
  background: linear-gradient(135deg, #E8E8E8, #C0C0C0);
  color: #ffffff;
  font-weight: bold;
  border-radius: 50%;
}

.rank-badge.rank-2 {
  background: linear-gradient(135deg, #D8A25F, #B87333);
  color: #ffffff;
  font-weight: bold;
  border-radius: 50%;
}

.results-empty {
  text-align: center;
  padding: 24rpx 0;
  color: #999;
  font-size: 24rpx;
}

/* ============ 空状态 ============ */
.expand-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 24rpx;
}

.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
