<view class="match-page">
  <view class="page-heading">
    <view>
      <text class="eyebrow">赛事成绩中心</text>
      <text class="page-title">赛场上的每一刻</text>
    </view>
    <view class="heading-mark" aria-hidden="true"><view></view><view></view><view></view></view>
  </view>

  <view class="status-tabs">
    <button class="status-tab {{meetingStatus === 2 ? 'selected' : ''}}" data-status="2" bindtap="onStatusTap" hover-class="pressed" aria-label="查看进行中的运动会">进行中</button>
    <button class="status-tab {{meetingStatus === 3 ? 'selected' : ''}}" data-status="3" bindtap="onStatusTap" hover-class="pressed" aria-label="查看已结束的运动会">历史赛况</button>
  </view>

  <view class="feedback-bar" wx:if="{{pageError}}">
    <text>{{pageError}}</text>
    <button class="text-button" bindtap="loadMeetings" disabled="{{loading}}">重试</button>
  </view>

  <block wx:if="{{activeMeeting}}">
    <view class="meeting-card">
      <view class="ui-track-art"></view>
      <view class="meeting-topline">
        <text class="status-label {{meetingStatus === 3 ? 'finished' : ''}}">{{meetingStatus === 2 ? '进行中' : '已结束'}}</text>
        <text class="meeting-count">{{meetingOptions.length}} 场运动会可查看</text>
      </view>
      <picker mode="selector" range="{{meetingOptions}}" range-key="name" value="{{meetingIndex}}" bindchange="onMeetingChange" disabled="{{meetingOptions.length < 2}}" aria-label="选择运动会">
        <view class="meeting-selector">
          <text class="meeting-name">{{activeMeeting.name}}</text>
          <view class="switch-label" wx:if="{{meetingOptions.length > 1}}">切换<text class="chevron down"></text></view>
        </view>
      </picker>
      <view class="meeting-meta" wx:if="{{activeMeeting.competitionDate || activeMeeting.venue}}">
        <text wx:if="{{activeMeeting.competitionDate}}">{{activeMeeting.competitionDate}}</text>
        <text wx:if="{{activeMeeting.venue}}">{{activeMeeting.venue}}</text>
      </view>
      <view class="meeting-bottom">
        <view class="meeting-stats">
          <view><text class="stat-number">{{eventsLoading && !eventCount ? '—' : eventCount}}</text><text class="stat-label">比赛项目</text></view>
          <view><text class="stat-number">{{scheduleCount}}</text><text class="stat-label">比赛轮次</text></view>
        </view>
        <button class="ranking-button" bindtap="goToRanking" hover-class="pressed">团体总分<text class="chevron"></text></button>
      </view>
    </view>

    <view class="filter-panel">
      <view class="search-box">
        <image class="search-icon" src="/images/ui/search.svg" aria-hidden="true" />
        <input class="search-input" value="{{keyword}}" bindinput="onSearchInput" placeholder="搜索项目名称、组别或性别" placeholder-class="input-placeholder" confirm-type="search" aria-label="搜索比赛项目" />
        <button wx:if="{{keyword}}" class="clear-button" bindtap="clearFilters" aria-label="清空搜索和筛选">清空</button>
      </view>
      <view class="category-tabs">
        <button wx:for="{{categories}}" wx:key="*this" class="category-tab {{category === item || (!category && item === '全部') ? 'selected' : ''}}" data-category="{{item}}" bindtap="onCategoryTap" hover-class="pressed">{{item}}</button>
      </view>
      <view class="filter-summary">
        <picker mode="selector" range="{{groupOptions}}" range-key="name" value="{{groupIndex}}" bindchange="onGroupChange" aria-label="按组别筛选项目">
          <view class="group-picker">{{groupOptions[groupIndex].name}}<text class="chevron down"></text></view>
        </picker>
        <text class="filter-count">{{events.length}} / {{eventCount}} 个项目</text>
      </view>
    </view>

    <view class="section-heading">
      <text class="section-title">项目成绩</text>
      <text class="update-label">{{loading || eventsLoading ? '正在更新…' : (updatedAt ? updatedAt + ' 项目更新' : '下拉刷新')}}</text>
    </view>
    <view class="feedback-bar" wx:if="{{eventsError || scheduleError}}">
      <text>{{eventsError || scheduleError}}</text>
      <button class="text-button" bindtap="retryEvents" disabled="{{eventsLoading}}">重试</button>
    </view>

    <view class="skeleton-list" wx:if="{{eventsLoading && !eventCount}}" aria-label="正在加载项目">
      <view class="skeleton-card" wx:for="{{[1, 2, 3]}}" wx:key="*this"><view class="skeleton-line wide"></view><view class="skeleton-line short"></view></view>
    </view>
    <view wx:elif="{{events.length > 0}}">
      <view class="event-card {{expandedEventId === item.key ? 'expanded' : ''}}" wx:for="{{events}}" wx:key="key">
        <button class="event-header" bindtap="onEventTap" data-key="{{item.key}}" hover-class="card-pressed" aria-label="{{item.name}}，{{item.groupTypeName}}，{{item.gender}}，{{expandedEventId === item.key ? '收起成绩' : '展开成绩'}}">
          <view class="event-type {{item.category === '田赛' ? 'field' : (item.category === '团队赛' ? 'team' : '')}}">{{item.category === '田赛' ? '田' : (item.category === '团队赛' ? '团' : '径')}}</view>
          <view class="event-info">
            <text class="event-name">{{item.name}}</text>
            <text class="event-meta">{{item.groupTypeName}} · {{item.gender}} · {{item.category}}</text>
          </view>
          <view class="event-action"><text>{{expandedEventId === item.key ? '收起' : '成绩'}}</text><text class="chevron {{expandedEventId === item.key ? 'up' : 'down'}}"></text></view>
        </button>
        <view class="event-results" wx:if="{{expandedEventId === item.key}}">
          <view class="inline-state" wx:if="{{eventsLoading || item.resultState === 'loading'}}">正在加载成绩…</view>
          <view class="inline-state" wx:elif="{{item.resultState === 'error' || item.resultState === 'idle'}}">
            <text>{{item.resultError || '成绩尚未加载'}}</text>
            <button class="retry-button" data-key="{{item.key}}" bindtap="retryResults" hover-class="pressed">重新加载</button>
          </view>
          <block wx:elif="{{item.results.length > 0}}">
            <view class="round-block" wx:for="{{item.results}}" wx:for-item="round" wx:key="key">
              <view class="round-title"><text class="round-name">{{round.scheduleName}}</text><text class="round-count">已录入 {{round.scoredCount}} / {{round.rows.length}} 人</text></view>
              <view class="result-row result-head"><text class="col-rank">序位</text><text class="col-name">选手 / 单位</text><text class="col-score">成绩</text><text class="col-points">积分</text></view>
              <view class="result-row" wx:for="{{round.rows}}" wx:for-item="rs" wx:key="key">
                <view class="col-rank"><text class="rank-badge {{rs.rank && rs.rank <= 3 ? 'rank-' + rs.rank : ''}}">{{rs.rank || '—'}}</text></view>
                <view class="col-name"><text class="result-name">{{rs.name}}</text><text class="result-unit" wx:if="{{rs.unit}}">{{rs.unit}}</text></view>
                <text class="col-score {{rs.hasScore ? '' : 'no-score'}}">{{rs.score}}</text>
                <text class="col-points">{{rs.hasScore ? rs.points : '—'}}</text>
              </view>
            </view>
            <view class="result-note">序位按成绩排序展示，最终名次以赛事公告为准。</view>
          </block>
          <view class="inline-state" wx:else><text class="state-title">成绩待公布</text><text>录入后可下拉刷新查看</text></view>
        </view>
      </view>
    </view>
    <view class="empty-state compact" wx:elif="{{!eventsError}}">
      <text class="state-title">{{eventCount ? '没有找到匹配的项目' : '比赛项目待公布'}}</text>
      <text class="state-description">{{eventCount ? '试试其他关键词，或重置筛选条件' : '项目公布后，可在这里查看各轮次成绩'}}</text>
      <button wx:if="{{eventCount}}" class="retry-button" bindtap="clearFilters" hover-class="pressed">重置筛选</button>
    </view>
    <text class="page-footnote">成绩以赛事公布为准 · 下拉可刷新</text>
  </block>

  <view class="empty-state" wx:elif="{{loading}}"><view class="skeleton-line wide"></view><text class="state-description">正在加载运动会…</text></view>
  <view class="empty-state" wx:elif="{{!pageError}}">
    <view class="empty-emblem" aria-hidden="true"><view></view><view></view><view></view></view>
    <text class="state-title">{{meetingStatus === 2 ? '暂无进行中的运动会' : '暂无历史赛况'}}</text>
    <text class="state-description">{{meetingStatus === 2 ? '可以前往历史赛况，回顾已结束的比赛' : '运动会结束后，成绩仍会保留在这里'}}</text>
    <button wx:if="{{meetingStatus === 2}}" class="retry-button" data-status="3" bindtap="onStatusTap" hover-class="pressed">查看历史赛况</button>
  </view>
</view>
