<!--match.wxml-->
<view class="match-page">

  <view wx:if="{{meetings.length > 0}}">
    <view class="match-card" wx:for="{{meetings}}" wx:key="id">
      <!-- 运动会标题（点击展开/收起） -->
      <view class="match-header" bindtap="toggleExpand" data-id="{{item.id}}">
        <view class="match-header-left">
          <text class="match-name">{{item.name}}</text>
          <view class="match-meta">
            <text class="match-meta-item">{{item.organizer}}</text>
            <text class="match-meta-item">{{item.competitionDate}}</text>
          </view>
        </view>
        <view class="match-arrow {{expandedId === item.id ? 'expanded' : ''}}">▼</view>
      </view>

      <!-- 展开的项目列表 -->
      <view class="match-expand" wx:if="{{expandedId === item.id}}">
        <view class="expand-title">正在进行的项目</view>

        <scroll-view scroll-x class="event-scroll" wx:if="{{item.events && item.events.length > 0}}">
          <view class="event-scroll-inner">
            <view class="event-card" wx:for="{{item.events}}" wx:for-item="evt" wx:key="id">
              <text class="event-card-name">{{evt.name}}</text>
              <text class="event-card-info">{{evt.groupType}} · {{evt.gender}}</text>
              <text class="event-card-cat">{{evt.category}}</text>
            </view>
          </view>
        </scroll-view>

        <view class="expand-empty" wx:if="{{!item.events || item.events.length === 0}}">
          <text>加载中...</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-box" wx:else>
    <text class="empty-icon">🏟️</text>
    <text class="empty-text">暂无进行中的运动会</text>
  </view>

</view>
