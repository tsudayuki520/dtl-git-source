/**profile.wxss**/
page { background-color: #f5f5f5; }
.profile-page { min-height: 100vh; padding: 24rpx; box-sizing: border-box; }

/* 未登录 */
.login-prompt {
  margin-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.login-prompt-text { font-size: 28rpx; color: #909399; margin-bottom: 32rpx; }
.login-btn {
  background-color: #2196F3; color: #fff;
  font-size: 28rpx; padding: 20rpx 80rpx;
  border-radius: 44rpx; text-align: center;
}

/* 用户卡片 */
.user-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.user-name { font-size: 36rpx; font-weight: bold; color: #303133; }
.user-code { font-size: 26rpx; color: #909399; margin-top: 12rpx; }

/* 菜单 */
.menu {
  margin-top: 24rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  overflow: hidden;
}
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.menu-item:last-child { border-bottom: none; }
.menu-item:active { background-color: #f5f5f5; }
.menu-text { font-size: 30rpx; color: #303133; }
.menu-arrow { font-size: 36rpx; color: #c0c4cc; }
.menu-item.logout { justify-content: center; }
.menu-item.logout .menu-text { color: #f56c6c; }
