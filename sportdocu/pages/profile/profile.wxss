.profile-page { padding: 32rpx 28rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.identity-card { position: relative; overflow: hidden; padding: 36rpx; background: #fff; color: var(--sport-ink); border: 1rpx solid var(--sport-border); border-radius: 30rpx; box-shadow: var(--sport-shadow); }
.identity-main { display: flex; align-items: center; gap: 24rpx; position: relative; }
.avatar { width: 112rpx; height: 112rpx; border-radius: 32rpx; background: #eef4ff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.avatar image { width: 64rpx; height: 64rpx; }
.identity-info { min-width: 0; flex: 1; }
.user-name { display: block; font-size: 38rpx; font-weight: 600; word-break: break-all; }
.user-code { display: block; font-size: 24rpx; color: var(--sport-muted); margin-top: 12rpx; word-break: break-all; }
.identity-footer { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; flex-wrap: wrap; margin-top: 32rpx; padding-top: 24rpx; border-top: 1rpx solid var(--sport-border); font-size: 24rpx; color: var(--sport-muted); }
.identity-badge { color: var(--sport-primary); background: var(--sport-primary-soft); padding: 6rpx 16rpx; border-radius: 10rpx; }
.login-btn { display: flex; align-items: center; justify-content: space-between; position: relative; margin: 30rpx 0 0; min-height: max(92rpx,44px); padding: 16rpx 28rpx; border-radius: 18rpx; background: var(--sport-primary); color: #fff; font-size: 28rpx; font-weight: 600; line-height: 1.5; }
.personal-grid { display: flex; gap: 20rpx; }
.personal-card { flex: 1; min-width: 0; text-align: left; margin: 0; padding: 28rpx; border: 1rpx solid var(--sport-border); border-radius: 28rpx; background: #fff; line-height: 1.5; box-shadow: var(--sport-shadow); }
.team-icon { background: var(--sport-primary-soft); }
.personal-title { display: block; color: var(--sport-ink); font-size: 32rpx; font-weight: 600; margin-top: 24rpx; }
.personal-desc { display: block; color: var(--sport-muted); font-size: 24rpx; margin-top: 10rpx; min-height: 72rpx; }
.personal-link { display: block; color: var(--sport-primary); font-size: 24rpx; margin-top: 16rpx; }
.account-menu { border: 1rpx solid var(--sport-border); border-radius: 28rpx; overflow: hidden; background: #fff; }
.menu-item { display: flex; align-items: center; gap: 20rpx; width: 100%; box-sizing: border-box; padding: 28rpx; text-align: left; background: transparent; margin: 0; line-height: 1.5; color: var(--sport-muted); }
.menu-icon { width: 76rpx; height: 76rpx; background: #f3f6fb; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; }
.menu-copy { flex: 1; }
.menu-title { display: block; color: var(--sport-ink); font-size: 28rpx; font-weight: 600; }
.menu-desc { display: block; color: var(--sport-muted); font-size: 24rpx; margin-top: 6rpx; }
.logout-button { width: 100%; box-sizing: border-box; background: #fff; color: #ac4753; border: 1rpx solid var(--sport-border); border-radius: 22rpx; min-height: max(92rpx,44px); margin-top: 28rpx; font-size: 28rpx; line-height: 92rpx; }
@media (max-width:350px) { .personal-desc,.personal-link,.menu-desc,.user-code,.identity-footer { font-size: 12px; } }

.menu-item + .menu-item { border-top: 1rpx solid var(--sport-border); }
