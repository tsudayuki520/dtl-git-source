<!--profile.wxml-->
<view class="profile-page">

  <!-- 未登录 -->
  <view wx:if="{{!userInfo}}" class="login-prompt">
    <text class="login-prompt-text">请先登录查看个人信息</text>
    <button class="login-btn" bindtap="goLogin">登录</button>
  </view>

  <!-- 已登录 -->
  <view wx:else>
    <view class="user-card">
      <text class="user-name">{{userInfo.name}}</text>
      <text class="user-code">{{userInfo.userCode}}</text>
    </view>

    <view class="menu">
      <view class="menu-item" bindtap="goMyRegistrations">
        <text class="menu-text">我的参赛项目</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goMyTeams">
        <text class="menu-text">我的队伍</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="changePassword">
        <text class="menu-text">修改密码</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item logout" bindtap="onLogout">
        <text class="menu-text">退出登录</text>
      </view>
    </view>
  </view>

</view>
