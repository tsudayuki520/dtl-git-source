<!--profile.wxml-->
<view class="profile-page">

  <!-- 未登录 -->
  <view class="login-tip" wx:if="{{!userInfo}}">
    <text class="login-text">请先登录</text>
  </view>

  <!-- 已登录 -->
  <view wx:else>

    <!-- 头像和昵称 -->
    <view class="profile-header">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="avatar" src="{{userInfo.avatarUrl || defaultAvatar}}" mode="aspectFill" />
        <view class="avatar-edit">编辑</view>
      </button>
      <view class="nickname-area">
        <input class="nickname-input" type="nickname" placeholder="点击设置昵称"
               value="{{userInfo.nickname}}" bindblur="onNicknameConfirm" />
      </view>
    </view>

    <!-- 用户信息 -->
    <view class="info-card">
      <view class="info-item">
        <text class="info-label">手机号</text>
        <text class="info-value">{{userInfo.phone || '未绑定'}}</text>
      </view>
    </view>

    <!-- 退出登录 -->
    <view class="logout-btn" bindtap="onLogout">退出登录</view>

  </view>

</view>
