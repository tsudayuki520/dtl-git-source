.cp-page { padding: 60rpx 40rpx; }
.cp-card {
  background: #fff; border-radius: 16rpx; padding: 48rpx 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  display: flex; flex-direction: column; gap: 24rpx;
}
.cp-input {
  border: 1rpx solid #dcdfe6; border-radius: 8rpx;
  padding: 20rpx 24rpx; font-size: 28rpx;
}
.cp-btn { background: #2196F3; color: #fff; border-radius: 8rpx; margin-top: 16rpx; }
