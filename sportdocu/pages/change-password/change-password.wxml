<view class="cp-page">
  <view class="ui-intro"><text class="ui-eyebrow">账号安全</text><text class="ui-page-title">设置新的密码</text><text class="ui-description">请妥善保管密码，保护你的参赛信息。</text></view>
  <view class="cp-card">
    <view><label for="old-password" class="ui-field-label">当前密码</label><input id="old-password" class="ui-input" placeholder="请输入当前密码" placeholder-class="ui-input-placeholder" password value="{{oldPassword}}" bindinput="onInputOld" /></view>
    <view><label for="new-password" class="ui-field-label">新密码</label><input id="new-password" class="ui-input" placeholder="请输入新密码" placeholder-class="ui-input-placeholder" password value="{{newPassword}}" bindinput="onInputNew" /></view>
    <view><label for="confirm-password" class="ui-field-label">确认新密码</label><input id="confirm-password" class="ui-input" placeholder="再次输入新密码" placeholder-class="ui-input-placeholder" password value="{{confirm}}" bindinput="onInputConfirm" /></view>
    <button class="ui-primary-button" loading="{{loading}}" disabled="{{loading}}" bindtap="handleSubmit" hover-class="ui-pressed">确认修改</button>
  </view>
</view>
