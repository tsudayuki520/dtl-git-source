@import "../../styles/lists.wxss";
.top-bar { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; margin-bottom: 32rpx; }
.top-title { font-size: 40rpx; font-weight: 700; }
.switch-wrap { display: flex; align-items: center; min-height: 44px; }
.switch-label { color: var(--sport-muted); font-size: 26rpx; }
.notice-card { border-left: 6rpx solid #80a5ec; }
.notice-card.read { border-left-color: #dfe6ef; }
.notice-top { display: flex; align-items: flex-start; gap: 20rpx; }
.notice-title { flex: 1; min-width: 0; font-size: 30rpx; font-weight: 600; word-break: break-all; line-height: 1.7; }
.notice-time { display: block; font-size: 24rpx; color: var(--sport-muted); margin-top: 20rpx; }
.unread-dot { height: 14rpx; width: 14rpx; background: var(--sport-primary); border-radius: 50%; flex-shrink: 0; margin-top: 16rpx; }
