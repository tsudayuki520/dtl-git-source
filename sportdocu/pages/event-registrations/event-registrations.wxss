@import "../../styles/lists.wxss";
.summary-card { background: var(--sport-primary-soft); border-color: var(--sport-border); padding: 36rpx; }
.summary-title { color: var(--sport-ink); font-size: 36rpx; }
.summary-meta { color: var(--sport-muted); margin-top: 14rpx; }
.reg-item { display: flex; align-items: center; gap: 24rpx; }
.reg-index { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 20rpx; background: var(--sport-primary-soft); color: var(--sport-primary); font-size: 28rpx; font-weight: 600; flex-shrink: 0; }
.reg-info { flex: 1; min-width: 0; }
.reg-name { display: block; font-size: 30rpx; font-weight: 600; word-break: break-all; }
.reg-team { margin-top: 8rpx; word-break: break-all; }
