.login-page { padding: 56rpx 36rpx; }
.login-brand { display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; border-radius: 34rpx; background: #e8f0ff; margin-bottom: 32rpx; transform: rotate(-7deg); }
.login-brand image { width: 74rpx; height: 74rpx; }
.login-card { display: flex; flex-direction: column; gap: 36rpx; padding: 36rpx; background: #fff; border: 1rpx solid var(--sport-border); border-radius: 30rpx; box-shadow: var(--sport-shadow); }
.login-hint { display: flex; align-items: flex-start; gap: 14rpx; font-size: 24rpx; color: var(--sport-muted); line-height: 1.8; }
.login-hint image { width: 30rpx; height: 30rpx; flex-shrink: 0; margin-top: 6rpx; }
.login-hint text { white-space: pre-line; }
.login-hint-line { display: block; }
@media (max-width:350px) { .login-hint { font-size: 12px; }.login-card { padding: 28rpx; } }
