<view class="login-page">
  <view class="login-brand"><image src="/images/ui/track.svg" /></view>
  <view class="ui-intro"><text class="ui-eyebrow">欢迎回到校园赛场</text><text class="ui-page-title">准备好，出发。</text><text class="ui-description">登录你的账号，查看参赛项目与队伍信息。</text></view>
  <view class="login-card">
    <view><label for="login-code" class="ui-field-label">学号 / 工号</label><input id="login-code" class="ui-input" placeholder="请输入学号或工号" placeholder-class="ui-input-placeholder" value="{{userCode}}" bindinput="onInputCode" /></view>
    <view><label for="login-password" class="ui-field-label">登录密码</label><input id="login-password" class="ui-input" placeholder="请输入密码" placeholder-class="ui-input-placeholder" password value="{{password}}" bindinput="onInputPwd" confirm-type="done" /></view>
    <button class="ui-primary-button" loading="{{loading}}" disabled="{{loading}}" bindtap="handleLogin" hover-class="ui-pressed">{{loading ? '正在登录' : '登录账号'}}</button>
    <view class="login-hint"><image src="/images/ui/shield.svg" /><text>默认密码：dlust123456<text class="login-hint-line">首次登录后，请前往“我的”修改密码。</text></text></view>
  </view>
  <text class="ui-footer">每一场比赛，从这里开始</text>
</view>
