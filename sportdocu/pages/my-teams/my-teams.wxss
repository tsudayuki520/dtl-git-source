@import "../../styles/lists.wxss";
.team-score { flex-shrink: 0; }
.team-score-num { font-size: 42rpx; font-weight: 700; color: var(--sport-primary); font-variant-numeric: tabular-nums; }
.team-score-unit { font-size: 24rpx; color: var(--sport-muted); margin-left: 8rpx; }
.team-meeting { margin-top: 16rpx; }
.team-meta { display: flex; flex-wrap: wrap; gap: 12rpx 24rpx; margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--sport-border); }
.team-meta-item { color: var(--sport-muted); font-size: 24rpx; }
