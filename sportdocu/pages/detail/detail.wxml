<!--detail.wxml-->
<scroll-view class="detail-page" scroll-y enhanced show-scrollbar="{{false}}">
  <!-- 运动会基本信息 -->
  <view class="detail-card" wx:if="{{meeting.id}}">
    <view class="detail-header">
      <text class="detail-name">{{meeting.name}}</text>
      <text class="detail-status" style="background-color: {{statusColor[meeting.status]}}">{{statusMap[meeting.status]}}</text>
    </view>

    <view class="info-group">
      <view class="info-row">
        <text class="info-label">主办单位</text>
        <text class="info-value">{{meeting.organizer}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">联系电话</text>
        <text class="info-value">{{meeting.contactPhone}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">比赛地址</text>
        <text class="info-value">{{meeting.venue}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">比赛日期</text>
        <text class="info-value">{{meeting.competitionDate}}</text>
      </view>
    </view>
  </view>

  <!-- 报名时间卡片 -->
  <view class="time-card" wx:if="{{meeting.registrationStart}}">
    <view class="time-card-row">
      <view class="time-block">
        <text class="time-label">报名开始</text>
        <text class="time-date">{{meeting.registrationStart}}</text>
      </view>
      <view class="time-arrow">→</view>
      <view class="time-block">
        <text class="time-label">报名截止</text>
        <text class="time-date">{{meeting.registrationEnd}}</text>
      </view>
    </view>
  </view>

  <!-- 功能模块 -->
  <view class="section-title">功能模块</view>
  <view class="module-grid">
    <view class="module-item" bindtap="goToSchedule">
      <view class="module-icon icon-schedule"></view>
      <text class="module-text">赛程</text>
    </view>
    <view class="module-item" bindtap="goToSignSheet">
      <view class="module-icon icon-sign"></view>
      <text class="module-text">签名表</text>
    </view>
    <view class="module-item" bindtap="goToPlayerList">
      <view class="module-icon icon-player"></view>
      <text class="module-text">选手名单</text>
    </view>
    <view class="module-item" bindtap="goToResult">
      <view class="module-icon icon-result"></view>
      <text class="module-text">成绩公告</text>
    </view>
    <view class="module-item" bindtap="goToAppeal">
      <view class="module-icon icon-appeal"></view>
      <text class="module-text">申述</text>
    </view>
  </view>

  <!-- 比赛项目 -->
  <view class="section-title">比赛项目</view>
  <view wx:for="{{eventCategories}}" wx:key="category">
    <view class="category-label">{{item.category}}</view>
    <view class="event-grid">
      <view class="event-tag" wx:for="{{item.events}}" wx:for-item="evt" wx:key="id" bindtap="goToEventRegistrations" data-id="{{evt.id}}" data-name="{{evt.name}}">
          <text class="event-name">{{evt.name}}</text>
          <view class="event-meta">
            <text class="event-info">{{evt.groupTypeName}} · {{evt.gender}}</text>
            <text class="event-badge {{evt.allowRegister ? 'badge-open' : 'badge-advance'}}">{{evt.allowRegister ? '可报名' : '仅晋级'}}</text>
          </view>
          <view class="event-reg-count">已报名 {{evt.registeredCount || 0}}<text wx:if="{{evt.registerLimit > 0}}"> / {{evt.registerLimit}}</text><text wx:else> · 不限</text></view>
        </view>
    </view>
  </view>

  <!-- 赛事通知 -->
  <view class="section-title">赛事通知</view>
  <view class="notice-list" wx:if="{{notices.length > 0}}">
    <view class="notice-item" wx:for="{{notices}}" wx:key="id" bindtap="goToNoticeDetail" data-id="{{item.id}}">
      <view class="notice-dot"></view>
      <view class="notice-content">
        <text class="notice-title">{{item.title}}</text>
        <text class="notice-time">{{item.createTime}}</text>
      </view>
    </view>
  </view>
  <view class="empty-tip" wx:else>暂无赛事通知</view>

  <!-- 底部留白，防止横幅遮挡 -->
  <view style="height: 160rpx;"></view>
</scroll-view>

<!-- 固定底部横幅 -->
<view class="bottom-bar">
  <view class="bottom-bar-info">
    <text class="bottom-bar-name">{{meeting.name}}</text>
    <text class="bottom-bar-hint" wx:if="{{meeting.status === 0}}">运动会筹备中</text>
    <text class="bottom-bar-hint" wx:elif="{{regOpen}}">报名进行中，快来参加吧</text>
    <text class="bottom-bar-hint" wx:elif="{{meeting.status === 1}}">当前不在报名时间内</text>
    <text class="bottom-bar-hint" wx:elif="{{meeting.status === 2}}">比赛进行中</text>
    <text class="bottom-bar-hint" wx:else>比赛已结束</text>
  </view>
  <view class="register-btn" wx:if="{{regOpen}}" bindtap="goToRegister">报名参赛</view>
  <view class="register-btn disabled" wx:else>未开放</view>
</view>
