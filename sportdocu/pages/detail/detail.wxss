@import "../../styles/lists.wxss";
.detail-page { height: 100vh; padding: 32rpx 28rpx 0; box-sizing: border-box; }
.detail-card { margin-bottom: 24rpx; padding: 36rpx; }
.detail-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; padding-bottom: 28rpx; border-bottom: 1rpx solid var(--sport-border); }
.detail-name { flex: 1; min-width: 0; font-size: 38rpx; font-weight: 700; line-height: 1.5; word-break: break-all; }
.info-group { padding-top: 12rpx; }
.info-row { display: flex; gap: 20rpx; padding: 18rpx 0; font-size: 27rpx; }
.info-label { width: 140rpx; flex-shrink: 0; color: var(--sport-muted); }
.info-value { flex: 1; min-width: 0; color: var(--sport-ink); word-break: break-all; }
.time-card { padding: 28rpx; border: 1rpx solid #dce7fc; border-radius: 26rpx; background: #edf3ff; }
.time-card-row { display: flex; align-items: center; gap: 16rpx; }
.time-block { flex: 1; min-width: 0; }
.time-label { display: block; font-size: 24rpx; color: #526b96; margin-bottom: 10rpx; }
.time-date { display: block; font-size: 26rpx; line-height: 1.7; color: #274c8e; font-weight: 600; word-break: break-all; }
.time-arrow { color: #7e9aca; font-size: 30rpx; }
.section-title { font-size: 34rpx; font-weight: 700; margin: 36rpx 0 24rpx; }
.module-grid { display: flex; gap: 20rpx; }
.module-item { display: flex; align-items: center; gap: 18rpx; flex: 1; min-width: 0; padding: 28rpx 20rpx; background: #fff; border: 1rpx solid var(--sport-border); border-radius: 26rpx; box-shadow: var(--sport-shadow); }
.module-icon { width: 70rpx; height: 70rpx; border-radius: 22rpx; background: #edf3ff; padding: 16rpx; box-sizing: border-box; flex-shrink: 0; }
.module-copy { min-width: 0; }
.module-text { display: block; font-size: 28rpx; font-weight: 600; }
.module-hint { display: block; color: var(--sport-muted); font-size: 22rpx; margin-top: 6rpx; }
.category-label { display: flex; align-items: center; gap: 12rpx; color: var(--sport-primary); font-size: 26rpx; font-weight: 600; margin: 24rpx 0 16rpx; }
.category-label::before { content: ""; height: 24rpx; width: 6rpx; background: var(--sport-primary); border-radius: 4rpx; }
.event-grid { display: flex; flex-direction: column; gap: 16rpx; }
.event-tag { background: #fff; border: 1rpx solid var(--sport-border); border-radius: 24rpx; padding: 26rpx 28rpx; }
.event-name { font-size: 30rpx; }
.event-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.event-info { font-size: 24rpx; color: var(--sport-muted); }
.event-round, .event-badge { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 8rpx; }
.event-round { color: #2f609d; background: #edf3ff; }
.event-round.final { color: #956019; background: #fff5e2; }
.event-round.semi { color: #6e58a0; background: #f3effb; }
.badge-open { color: #247249; background: #eaf7ef; }
.badge-advance { color: #956019; background: #fff5e2; }
.event-reg-count { color: var(--sport-muted); font-size: 24rpx; margin-top: 14rpx; }
.notice-list { background: #fff; border: 1rpx solid var(--sport-border); border-radius: 26rpx; padding: 4rpx 28rpx; }
.notice-item { display: flex; gap: 18rpx; padding: 26rpx 0; border-bottom: 1rpx solid var(--sport-border); }
.notice-item:last-child { border: 0; }
.notice-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--sport-primary); flex-shrink: 0; margin-top: 16rpx; }
.notice-content { flex: 1; min-width: 0; }
.notice-title { display: block; font-size: 28rpx; line-height: 1.7; word-break: break-all; }
.notice-time { display: block; font-size: 24rpx; color: var(--sport-muted); margin-top: 10rpx; }
.detail-bottom-space { height: calc(190rpx + env(safe-area-inset-bottom)); }
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 10; display: flex; align-items: center; gap: 24rpx; padding: 24rpx 28rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid var(--sport-border); box-shadow: 0 -8rpx 24rpx rgba(24,43,73,.04); }
.bottom-bar-info { flex: 1; min-width: 0; }
.bottom-bar-name { display: block; font-size: 28rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bottom-bar-hint { display: block; font-size: 24rpx; color: var(--sport-muted); margin-top: 8rpx; }
.register-btn { display: flex; align-items: center; justify-content: center; min-height: max(92rpx,44px); padding: 0 34rpx; border-radius: 20rpx; background: var(--sport-primary); color: #fff; font-size: 28rpx; font-weight: 600; flex-shrink: 0; }
.register-btn.disabled { background: #eef1f6; color: #7b8799; }
@media (max-width:350px) { .info-row,.time-date { font-size: 13px; }.time-label,.module-hint,.event-info,.event-round,.event-badge,.event-reg-count,.notice-time,.bottom-bar-hint { font-size: 12px; }.module-item { gap: 12rpx; padding: 24rpx 16rpx; }.module-icon { width: 58rpx; height: 58rpx; padding: 12rpx; } }
