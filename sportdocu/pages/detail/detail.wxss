/**detail.wxss**/
page {
  background-color: #f5f5f5;
}
.detail-page {
  height: 100vh;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.detail-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #eee;
}

.detail-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
}

.detail-status {
  font-size: 24rpx;
  color: #ffffff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.info-group {
  margin-top: 8rpx;
}

.info-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* 功能模块区域 */
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin: 32rpx 0 16rpx 8rpx;
}

.module-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.module-item {
  width: calc(25% - 15rpx);
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.module-item:active {
  opacity: 0.7;
}

.module-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.module-icon::after {
  font-size: 36rpx;
}

.icon-schedule {
  background-color: #e3f2fd;
}

.icon-schedule::after {
  content: "📋";
}

.module-text {
  font-size: 24rpx;
  color: #333;
}
