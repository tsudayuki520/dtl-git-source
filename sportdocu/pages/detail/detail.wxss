/**detail.wxss**/
page {
  background-color: #f5f5f5;
}
.detail-page {
  height: 100vh;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

/* 基本信息卡片 */
.detail-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #eee;
}

.detail-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
}

.detail-status {
  font-size: 24rpx;
  color: #ffffff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.info-group {
  margin-top: 8rpx;
}

.info-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* 报名时间卡片 */
.time-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.time-card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.time-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.time-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.time-date {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.time-arrow {
  font-size: 36rpx;
  color: #4CAF50;
  padding: 0 24rpx;
  flex-shrink: 0;
}

/* 分区标题 */
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin: 32rpx 0 16rpx 8rpx;
}

/* 功能模块区域 */
.module-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.module-item {
  width: calc(25% - 15rpx);
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.module-item:active {
  opacity: 0.7;
}

.module-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.module-icon::after {
  font-size: 36rpx;
}

.icon-schedule {
  background-color: #e3f2fd;
}
.icon-schedule::after {
  content: "📋";
}

.icon-result {
  background-color: #fce4ec;
}
.icon-result::after {
  content: "🏅";
}

.module-text {
  font-size: 24rpx;
  color: #333;
}

/* 比赛项目分类 */
.category-label {
  font-size: 26rpx;
  color: #2196F3;
  font-weight: bold;
  margin: 20rpx 0 12rpx 8rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #2196F3;
}

/* 比赛项目网格 */
.event-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.event-tag {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 14rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.event-name {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
}

.event-info {
  font-size: 20rpx;
  color: #2196F3;
}

.event-badge {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
}

.badge-open {
  color: #4CAF50;
  background-color: #e8f5e9;
}

.badge-advance {
  color: #FF9800;
  background-color: #fff3e0;
}

.event-reg-count {
  font-size: 20rpx;
  color: #909399;
  margin-top: 6rpx;
}

.event-tag:active {
  opacity: 0.7;
}

/* 赛事通知 */
.notice-list {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.notice-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.notice-item:last-child {
  border-bottom: none;
}

.notice-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #FF9800;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.notice-content {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  overflow: hidden;
}

.notice-title {
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  flex: 1;
  margin-right: 16rpx;
}

.notice-time {
  font-size: 22rpx;
  color: #999;
  white-space: nowrap;
  flex-shrink: 0;
}

.empty-tip {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* 固定底部横幅 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 44rpx;
  background-color: #ffffff;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.1);
}

.bottom-bar-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  margin-right: 24rpx;
  overflow: hidden;
}

.bottom-bar-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bottom-bar-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.register-btn {
  background-color: #4CAF50;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  padding: 20rpx 48rpx;
  border-radius: 44rpx;
  white-space: nowrap;
  text-align: center;
  flex-shrink: 0;
}

.register-btn:active {
  opacity: 0.8;
}

.register-btn.disabled {
  background-color: #cccccc;
  color: #ffffff;
}
