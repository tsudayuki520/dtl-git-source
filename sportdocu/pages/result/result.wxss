/* result.wxss - 团体总分排行 */
page {
  background-color: #f5f6fa;
}

.ranking-page {
  padding: 24rpx;
}

.page-header {
  padding: 8rpx 8rpx 24rpx;
}

.page-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.page-sub {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.rank-list {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
}

.rank-item + .rank-item {
  border-top: 1rpx solid #f5f5f5;
}

.rank-col {
  width: 72rpx;
  flex-shrink: 0;
  text-align: center;
}

.rank-badge {
  display: inline-block;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

.rank-badge.rank-0 {
  background: linear-gradient(135deg, #FFD700, #F5A623);
  color: #ffffff;
  font-weight: bold;
}

.rank-badge.rank-1 {
  background: linear-gradient(135deg, #E8E8E8, #C0C0C0);
  color: #ffffff;
  font-weight: bold;
}

.rank-badge.rank-2 {
  background: linear-gradient(135deg, #D8A25F, #B87333);
  color: #ffffff;
  font-weight: bold;
}

.team-info {
  flex: 1;
  padding: 0 12rpx;
  min-width: 0;
}

.team-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.team-leader {
  display: block;
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.score-col {
  flex-shrink: 0;
  text-align: right;
}

.team-score {
  font-size: 34rpx;
  font-weight: bold;
  color: #FF9800;
}

.score-unit {
  font-size: 20rpx;
  color: #999;
  margin-left: 4rpx;
}

.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
