@import "../../styles/lists.wxss";
.ranking-page { padding: 32rpx 28rpx; }
.page-header { position: relative; overflow: hidden; background: var(--sport-primary); padding: 36rpx; border-radius: 30rpx; color: #fff; margin-bottom: 32rpx; }
.ranking-kicker { display: block; color: #d9e6ff; font-size: 24rpx; letter-spacing: 3rpx; margin-bottom: 12rpx; position: relative; }
.page-title { display: block; font-size: 44rpx; font-weight: 700; position: relative; }
.page-sub { display: block; font-size: 26rpx; color: #d9e6ff; margin-top: 20rpx; position: relative; word-break: break-all; }
.rank-list { background: #fff; border: 1rpx solid var(--sport-border); border-radius: 28rpx; overflow: hidden; box-shadow: var(--sport-shadow); }
.rank-item { display: flex; align-items: center; gap: 12rpx; padding: 30rpx 22rpx; }
.rank-item + .rank-item { border-top: 1rpx solid var(--sport-border); }
.rank-item:first-child { background: #fffbf2; }
.rank-col { width: 72rpx; flex-shrink: 0; text-align: center; }
.rank-badge { display: inline-flex; align-items: center; justify-content: center; width: 52rpx; height: 58rpx; border-radius: 16rpx; font-size: 28rpx; font-weight: 600; color: var(--sport-muted); }
.rank-0 { background: #f9e8b3; color: #875819; }
.rank-1 { background: #e8eef7; color: #526784; }
.rank-2 { background: #f7e8db; color: #8f5c38; }
.team-info { flex: 1; min-width: 0; }
.team-name { font-size: 30rpx; }
.team-leader { display: block; font-size: 24rpx; color: var(--sport-muted); margin-top: 10rpx; }
.score-col { flex-shrink: 0; text-align: right; }
.team-score { font-size: 40rpx; color: var(--sport-primary); font-weight: 700; font-variant-numeric: tabular-nums; }
.score-unit { font-size: 24rpx; color: var(--sport-muted); margin-left: 6rpx; }
