/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

/* 搜索框 */
.search-bar {
  padding: 20rpx 24rpx 0;
}
.search-wrap {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 36rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}
.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 40rpx;
}

/* 轮播图 */
.banner-swiper {
  width: 100%;
  height: 360rpx;
}
.banner-image {
  width: 100%;
  height: 100%;
}
.banner-empty {
  width: 100%;
  height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e8f4fd 0%, #f0f7ff 100%);
  gap: 12rpx;
}
.banner-empty-icon {
  font-size: 64rpx;
}
.banner-empty-text {
  font-size: 26rpx;
  color: #909399;
}

/* 通知横幅 */
.notice-bar {
  display: flex;
  align-items: center;
  background-color: #FFF8E1;
  padding: 16rpx 24rpx;
  margin: 16rpx 24rpx 0;
  border-radius: 12rpx;
}
.notice-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.notice-swiper {
  flex: 1;
  height: 40rpx;
}
.notice-text {
  font-size: 26rpx;
  color: #E65100;
  line-height: 40rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 运动会列表 */
.section {
  padding: 20rpx 24rpx;
}
.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.meeting-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.meeting-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.meeting-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
}

.meeting-status {
  font-size: 22rpx;
  color: #ffffff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.meeting-info {
  margin-bottom: 8rpx;
}
.info-item {
  font-size: 26rpx;
  color: #666;
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 40rpx 0;
}
