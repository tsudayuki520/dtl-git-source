page { height: 100vh; display: flex; flex-direction: column; }
.scrollarea { flex: 1; min-height: 0; overflow-y: hidden; }
.home-page { padding: 36rpx 28rpx 0; }
.home-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32rpx; }
.home-title { display: block; font-size: 48rpx; font-weight: 700; letter-spacing: -1rpx; margin-top: 10rpx; }
.search-wrap { display: flex; align-items: center; min-height: max(96rpx,44px); padding: 0 26rpx; border: 1rpx solid var(--sport-border); background: #fff; border-radius: 22rpx; margin-bottom: 28rpx; }
.search-icon { width: 36rpx; height: 36rpx; margin-right: 18rpx; flex-shrink: 0; }
.search-input { height: 96rpx; min-height: 44px; flex: 1; min-width: 0; font-size: 28rpx; }
.home-hero, .banner-swiper { border-radius: 30rpx; overflow: hidden; margin-bottom: 28rpx; }
.banner-swiper { height: 336rpx; }
.banner-image { width: 100%; height: 100%; }
.home-hero { position: relative; background: #e3edff; padding: 36rpx; box-sizing: border-box; color: #1c4a94; min-height: 350rpx; }
.home-hero .ui-track-art, .home-hero .ui-track-art::before, .home-hero .ui-track-art::after { border-color: rgba(50,109,229,.16); }
.home-hero .ui-track-art { top: 40rpx; right: -140rpx; }
.hero-kicker { display: inline-block; position: relative; font-size: 24rpx; color: #236146; background: #fff; border-radius: 10rpx; padding: 6rpx 14rpx; }
.hero-title { display: block; position: relative; max-width: 86%; font-size: 46rpx; line-height: 1.4; font-weight: 700; margin: 20rpx 0; word-break: break-all; }
.hero-caption, .hero-venue { display: block; position: relative; font-size: 24rpx; color: #3e608d; word-break: break-all; }
.hero-venue { margin-top: 6rpx; }
.hero-button { display: inline-flex; align-items: center; justify-content: center; gap: 20rpx; position: relative; margin: 24rpx 0 0; min-height: max(88rpx,44px); padding: 12rpx 26rpx; border-radius: 18rpx; background: var(--sport-primary); color: #fff; font-size: 26rpx; font-weight: 600; line-height: 1.5; }
.quick-grid { display: flex; gap: 18rpx; margin-bottom: 28rpx; }
.quick-item { flex: 1; min-width: 0; margin: 0; padding: 24rpx 4rpx; background: #fff; border: 1rpx solid var(--sport-border); border-radius: 26rpx; line-height: 1.5; }
.quick-icon { display: flex; justify-content: center; align-items: center; width: 80rpx; height: 80rpx; border-radius: 24rpx; margin: 0 auto 16rpx; }
.blue, .green, .amber { background: var(--sport-primary-soft); }
.quick-name { display: block; font-size: 28rpx; color: var(--sport-ink); font-weight: 600; }
.quick-caption { display: block; font-size: 24rpx; color: var(--sport-muted); margin-top: 6rpx; }
.notice-bar { display: flex; align-items: center; gap: 16rpx; background: #edf2fb; border-radius: 18rpx; padding: 20rpx; color: var(--sport-primary); }
.notice-label { font-size: 22rpx; font-weight: 600; background: #fff; padding: 4rpx 12rpx; border-radius: 7rpx; flex-shrink: 0; }
.notice-swiper { flex: 1; min-width: 0; height: 40rpx; }
.notice-text { display: block; font-size: 26rpx; color: #425b7f; line-height: 40rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.meeting-card { background: #fff; border: 1rpx solid var(--sport-border); box-shadow: var(--sport-shadow); border-radius: 28rpx; padding: 30rpx; margin-bottom: 24rpx; }
.card-pressed { background: #f8faff; }
.meeting-header { display: flex; align-items: flex-start; gap: 16rpx; }
.meeting-name { flex: 1; min-width: 0; font-size: 33rpx; line-height: 1.5; font-weight: 600; word-break: break-all; }
.meeting-organizer { display: block; color: var(--sport-muted); font-size: 24rpx; margin-top: 14rpx; }
.meeting-location, .meeting-date { display: flex; align-items: center; gap: 12rpx; font-size: 24rpx; color: var(--sport-muted); }
.meeting-location { margin-top: 20rpx; }
.meeting-location image, .meeting-date image { width: 30rpx; height: 30rpx; flex-shrink: 0; }
.meeting-footer { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; border-top: 1rpx solid var(--sport-border); padding-top: 22rpx; margin-top: 24rpx; flex-wrap: wrap; }
.meeting-link { display: flex; align-items: center; gap: 16rpx; color: var(--sport-primary); font-size: 24rpx; font-weight: 600; }
.empty-tip { padding: 60rpx 20rpx; text-align: center; font-size: 30rpx; }
.empty-caption { display: block; font-size: 26rpx; color: var(--sport-muted); margin-top: 12rpx; }
@media (max-width:350px) { .quick-caption,.hero-venue { font-size: 12px; }.hero-kicker,.hero-caption,.meeting-organizer,.meeting-location,.meeting-date,.meeting-link { font-size: 12px; }.quick-name,.search-input { font-size: 14px; } }
