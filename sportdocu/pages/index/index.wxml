<!--index.wxml-->
<scroll-view class="scrollarea" scroll-y type="list">
  <!-- 搜索框 -->
  <view class="search-bar">
    <view class="search-wrap">
      <image class="search-icon" src="/images/search.png" mode="aspectFit" />
      <input class="search-input" placeholder="搜索运动会" placeholder-style="color:#bbb;" confirm-type="search" bindconfirm="onSearch" />
    </view>
  </view>

  <!-- 轮播图 -->
  <swiper class="banner-swiper" autoplay circular indicator-dots indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#ffffff" interval="3000" duration="500">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <image class="banner-image" src="{{item.imageUrl}}" mode="aspectFill"></image>
    </swiper-item>
  </swiper>

  <!-- 通知横幅（点击进入通知列表） -->
  <view class="notice-bar" wx:if="{{notices.length > 0}}" bindtap="goToNoticeList">
    <text class="notice-icon">📢</text>
    <swiper class="notice-swiper" vertical autoplay circular interval="3000" duration="500">
      <swiper-item wx:for="{{notices}}" wx:key="id">
        <text class="notice-text">{{item.title}}</text>
      </swiper-item>
    </swiper>
  </view>

  <!-- 运动会列表 -->
  <view class="section">
    <view class="section-title">运动会</view>
    <view class="meeting-list">
      <view class="meeting-card" wx:for="{{meetings}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
        <view class="meeting-header">
          <text class="meeting-name">{{item.name}}</text>
          <text class="meeting-status" style="background-color: {{statusColor[item.status]}}">{{statusMap[item.status]}}</text>
        </view>
        <view class="meeting-info">
          <text class="info-item">主办：{{item.organizer}}</text>
        </view>
        <view class="meeting-info">
          <text class="info-item">地点：{{item.venue}}</text>
        </view>
        <view class="meeting-info">
          <text class="info-item">比赛日期：{{item.competitionDate}}</text>
        </view>
      </view>
    </view>
    <view class="empty-tip" wx:if="{{meetings.length === 0}}">暂无运动会信息</view>
  </view>
</scroll-view>
