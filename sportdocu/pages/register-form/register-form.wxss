.form-page { padding: 40rpx 28rpx; }
.event-info { padding: 36rpx; background: #fff; border: 1rpx solid var(--sport-border); border-radius: 30rpx; margin-bottom: 32rpx; box-shadow: var(--sport-shadow); }
.event-label { display: block; color: var(--sport-muted); font-size: 24rpx; margin-top: 28rpx; }
.event-info-name { display: block; font-size: 40rpx; font-weight: 600; margin-top: 12rpx; word-break: break-all; }
.event-info-meta { display: inline-block; color: var(--sport-primary); background: var(--sport-primary-soft); padding: 10rpx 20rpx; border-radius: 12rpx; font-size: 26rpx; margin-top: 24rpx; }
