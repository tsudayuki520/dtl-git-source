/* register-form.wxss */
page {
  background-color: #f5f5f5;
}

.form-page {
  padding: 20rpx 24rpx;
}

/* 项目信息 */
.event-info {
  background-color: #e3f2fd;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.event-info-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.event-info-meta {
  font-size: 24rpx;
  color: #2196F3;
}

/* 表单卡片 */
.form-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.radio-group {
  display: flex;
  gap: 32rpx;
}

.radio-label {
  font-size: 28rpx;
  color: #333;
  display: flex;
  align-items: center;
}

/* 提交按钮 */
.submit-btn {
  background-color: #4CAF50;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 48rpx;
  margin-top: 40rpx;
}

.submit-btn:active {
  opacity: 0.8;
}

.submit-btn.disabled {
  opacity: 0.6;
}
