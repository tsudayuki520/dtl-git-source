@import "../../styles/lists.wxss";
.page { min-height: 100vh; height: auto; }
.search-wrap { display: flex; align-items: center; gap: 18rpx; background: #fff; border: 1rpx solid var(--sport-border); border-radius: 22rpx; padding: 0 24rpx; }
.search-icon { width: 36rpx; height: 36rpx; flex-shrink: 0; }
.search-input { flex: 1; min-width: 0; height: 100rpx; min-height: 44px; font-size: 28rpx; }
.result-tip { font-size: 26rpx; color: var(--sport-muted); margin: 28rpx 4rpx; }
.result-list { margin-top: 28rpx; }
